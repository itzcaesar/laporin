# ═══════════════════════════════════════════════════════════
# Laporin API — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.

# ── Database (Supabase) ───────────────────────────────────
# Pooler URL (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Direct URL (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Note: URL-encode special chars in password (e.g. // → %2F%2F)

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://default:[password]@[host]:[port]"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | head -c 48
JWT_SECRET="GENERATE-A-RANDOM-STRING-AT-LEAST-32-CHARS-LONG"
JWT_REFRESH_SECRET="GENERATE-ANOTHER-RANDOM-STRING-AT-LEAST-32-CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Required when frontend and API are subdomains of the same site, e.g. .laporin.site
COOKIE_DOMAIN=".laporin.site"

# ── Storage (Supabase S3) ─────────────────────────────────
S3_ENDPOINT="https://[project-ref].storage.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_BUCKET="laporin-media"
S3_ACCESS_KEY="your-supabase-s3-access-key"
S3_SECRET_KEY="your-supabase-s3-secret-key"
S3_PUBLIC_URL="https://[project-ref].storage.supabase.co/storage/v1/object/public/laporin-media"

# ── AI (OpenRouter) ───────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-..."
ANTHROPIC_API_KEY="sk-or-v1-..."

# ── Email (Resend) ────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_your_resend_key"
SMTP_FROM="noreply@laporin.site"

# ── WhatsApp (Fonnte) ─────────────────────────────────────
FONNTE_TOKEN="your-fonnte-token"

# ── Web Push (VAPID) ──────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="admin@laporin.site"

# ── App ───────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"
